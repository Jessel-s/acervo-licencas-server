# Copie este arquivo para .env e substitua pelos valores reais do seu Supabase
# Não commite o arquivo .env com chaves reais.

SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_ANON_KEY=sua-chave-anon

# Configuração do PDV local
PDV_SERIAL=PDV-001
PDV_CHAVE=LIC-TESTE-123
COLEGIO_ID=00000000-0000-0000-0000-000000000000

# Banco local da aplicação principal (opcional para desenvolvimento)
DATABASE_URL=
